{
  "name": "design-dna",
  "version": "1.0.0",
  "description": "Extract a design system from any website — colors, fonts, button styles — and export Figma-friendly JSON.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:popup": "vite build",
    "build:content": "vite build --config vite.content.config.ts",
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "typecheck": "tsc --noEmit",
    "local": "node scripts/run-local.mjs",
    "zip": "node scripts/build.mjs && node scripts/zip.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.19.41",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.28.0",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
